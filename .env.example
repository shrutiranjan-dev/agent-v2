AP_ENV=development
AP_LOG_LEVEL=INFO
AP_API_HOST=0.0.0.0
AP_API_PORT=8000
AP_ENABLE_TEST_ENDPOINTS=false
AP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

AP_DATABASE_URL=postgresql+asyncpg://agent:agent@postgres:5432/agent_platform
AP_DATABASE__POOL_SIZE=10
AP_DATABASE__MAX_OVERFLOW=20
AP_REDIS_URL=redis://redis:6379/0
AP_REDIS_PUBSUB_ENABLED=true
AP_QUEUE_ENABLED=true
AP_QUEUE_NAME=agent-platform:jobs
AP_QUEUE_DEAD_LETTER_NAME=agent-platform:jobs:dead
AP_QUEUE_MAX_ATTEMPTS=3
AP_QUEUE_POLL_TIMEOUT_SECONDS=5
AP_QUEUE_RETRY_BACKOFF_SECONDS=1
AP_QUEUE_VISIBILITY_TIMEOUT_SECONDS=300
AP_QUEUE_WORKER_ID=

AP_QDRANT_URL=http://qdrant:6333
AP_QDRANT_ENABLED=false
AP_QDRANT_COLLECTION=agent_platform_memory
AP_MEMORY_EMBEDDING_ENABLED=false
AP_MEMORY_EMBEDDING_MODEL=
AP_MEMORY_TEXT_SEARCH_LIMIT=8
AP_MEMORY_COMPACTION_THRESHOLD_RATIO=0.8
AP_MEMORY_COMPACTION_MIN_EXCLUDED_MESSAGES=4

AP_CODEINTEL_ENABLED=true
AP_CODEINTEL_LSP_ENABLED=false
AP_CODEINTEL_MAX_FILE_BYTES=512000
AP_CODEINTEL_MAX_FILES=5000
AP_LSP_ENABLED=false
AP_LSP_PYTHON_COMMAND=pylsp
AP_LSP_STARTUP_TIMEOUT_SECONDS=10
AP_LSP_REQUEST_TIMEOUT_SECONDS=10
AP_LSP_SHUTDOWN_TIMEOUT_SECONDS=5
AP_LSP_MAX_RESPONSE_CHARS=200000
AP_LSP_WORKSPACE_ROOT=/workspace

AP_MCP_ENABLED=true
AP_MCP_CONNECT_TIMEOUT_SECONDS=10
AP_MCP_CALL_TIMEOUT_SECONDS=30
AP_MCP_SHUTDOWN_TIMEOUT_SECONDS=5
AP_MCP_ALLOW_UNTRUSTED_STDIO=false
AP_MCP_ALLOWED_STDIO_COMMANDS=python,python3
AP_MCP_ENV_ALLOWLIST=
AP_MCP_MAX_RESPONSE_CHARS=20000

AP_PLUGINS_ENABLED=true
AP_PLUGINS_DIRECTORY=plugins
AP_PLUGINS_AUTO_REGISTER_TRUSTED_TOOLS=false

AP_NEO4J_URI=bolt://neo4j:7687
AP_NEO4J_USER=neo4j
AP_NEO4J_PASSWORD=agent-platform
AP_MINIO_ENDPOINT=minio:9000
AP_MINIO_ACCESS_KEY=minioadmin
AP_MINIO_SECRET_KEY=minioadmin
AP_MINIO_SECURE=false
AP_CLICKHOUSE_HOST=clickhouse
AP_CLICKHOUSE_PORT=8123
AP_CLICKHOUSE_USER=default
AP_CLICKHOUSE_PASSWORD=
AP_OLLAMA_BASE_URL=http://host.docker.internal:11434
AP_OLLAMA_TIMEOUT_SECONDS=120
AP_DEFAULT_OLLAMA_MODEL=qwen2.5:latest
AP_OLLAMA_BUILD_MODEL=
AP_OLLAMA_PLAN_MODEL=
AP_OLLAMA_GENERAL_MODEL=
AP_OLLAMA_EXPLORE_MODEL=
AP_OLLAMA_DISABLED_MODELS=
AP_OLLAMA_NON_JSON_MODELS=
AP_OLLAMA_NUM_PREDICT=64

AP_WORKSPACE_ROOT=/workspace
AP_PERMISSION_WAIT_TIMEOUT_SECONDS=600
AP_CONTEXT_CHAR_BUDGET=24000
AP_MAX_TOOL_REPEATS=3
AP_EXTERNAL_WRITE_POLICY=deny
AP_SECURITY_SECRET_KEY=dev-only-change-me

AP_BOOTSTRAP_ORGANIZATION_SLUG=local
AP_BOOTSTRAP_PROJECT_SLUG=default
AP_BOOTSTRAP_WORKSPACE_NAME=default
AP_BOOTSTRAP_USER_EMAIL=local-user@example.local

BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=5173
POSTGRES_HOST_PORT=15432
REDIS_HOST_PORT=16379
QDRANT_HTTP_HOST_PORT=16333
QDRANT_GRPC_HOST_PORT=16334
NEO4J_HTTP_HOST_PORT=17474
NEO4J_BOLT_HOST_PORT=17687
MINIO_API_HOST_PORT=19000
MINIO_CONSOLE_HOST_PORT=19001
CLICKHOUSE_HTTP_HOST_PORT=18123
CLICKHOUSE_NATIVE_HOST_PORT=19009

POSTGRES_DB=agent_platform
POSTGRES_USER=agent
POSTGRES_PASSWORD=agent
NEO4J_AUTH=neo4j/agent-platform
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Host-side smoke tests use the Docker-published PostgreSQL port.
# PowerShell example:
# $env:AP_TEST_POSTGRES_URL="postgresql+psycopg://agent:agent@localhost:15432/agent_platform"
# Bash example:
# export AP_TEST_POSTGRES_URL='postgresql+psycopg://agent:agent@localhost:15432/agent_platform'
AP_TEST_POSTGRES_URL=postgresql+psycopg://agent:agent@localhost:15432/agent_platform
